{
  "expo": {
    "name": "DebateAI",
    "slug": "debate_ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "debateai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#160022",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajakaiye.debateai",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DebateAI records your spoken arguments to transcribe and judge them."
      }
    },
    "android": {
      "package": "com.ajakaiye.debateai",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E0016",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0016",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DebateAI records your spoken arguments to transcribe and judge them."
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DebateAI listens to your spoken arguments to transcribe and judge them.",
          "speechRecognitionPermission": "DebateAI transcribes your spoken arguments on-device so the judge can score them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
