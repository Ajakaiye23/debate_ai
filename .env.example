# Copy this file to `.env` and fill in your keys.
# All EXPO_PUBLIC_ vars are bundled into the client app (visible in the build) —
# fine for a prototype; proxy secret keys server-side before production.
# You can also enter these at runtime on the Settings screen (stored on-device).

EXPO_PUBLIC_ANTHROPIC_API_KEY=        # console.anthropic.com → API Keys
EXPO_PUBLIC_OPENAI_API_KEY=           # platform.openai.com → API Keys (Whisper)
EXPO_PUBLIC_ELEVENLABS_API_KEY=       # elevenlabs.io → Profile → API Key
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=      # elevenlabs.io/voice-lab (pick any voice)

# Backend proxy (recommended before publishing). When set, the app routes all
# AI calls through it and the keys above are no longer needed in the app.
# See server/README.md. Leave empty to call the APIs directly (dev/prototype).
EXPO_PUBLIC_PROXY_URL=

# Online multiplayer only (not yet wired into the UI):
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
