# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit it.
# All EXPO_PUBLIC_ vars are bundled into the client app (extractable from the build) —
# fine while you are the only user; move the secrets behind the proxy before sharing it.

EXPO_PUBLIC_ANTHROPIC_API_KEY=        # console.anthropic.com → API Keys (the only one that matters)
EXPO_PUBLIC_OPENAI_API_KEY=           # optional — Whisper STT fallback inside Expo Go only

# Backend proxy (recommended before publishing). When set, the app routes all
# AI calls through it and the keys above are no longer needed in the app.
# See server/README.md. Leave empty to call the APIs directly (dev/prototype).
EXPO_PUBLIC_PROXY_URL=

# Shared password sent with every proxy request as `x-app-key`. Must match the
# APP_KEY set on the proxy, otherwise the proxy rejects the app with 401.
# Only needed when EXPO_PUBLIC_PROXY_URL is set.
EXPO_PUBLIC_APP_KEY=

# Online multiplayer + leaderboard (blank = those screens can't connect):
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
